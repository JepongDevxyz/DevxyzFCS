<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
     android:state_enabled="false">
    <shape
       android:shape="rectangle">
      <stroke
         android:width="1.0dip"
         android:color="@color/jx_start_bg"/>
      <gradient
         android:startColor="@color/jx_btnStart"
         android:endColor="@color/jx_btnEnd"
         android:angle="90.0"/>
      <corners
         android:topLeftRadius="100.0dip"
         android:topRightRadius="100.0dip"
         android:bottomLeftRadius="100.0dip"
         android:bottomRightRadius="100.0dip"/>
    </shape>
  </item>
  <item
     android:state_pressed="true">
    <shape
       android:shape="rectangle">
      <gradient
         android:startColor="@color/jx_btnEnd"
         android:endColor="@color/jx_btnStart"
         android:angle="90.0"/>
      <stroke
         android:width="1.0dip"
         android:color="@color/colorBtnStroke"/>
      <corners
         android:topLeftRadius="100.0dip"
         android:topRightRadius="100.0dip"
         android:bottomLeftRadius="100.0dip"
         android:bottomRightRadius="100.0dip"/>
    </shape>
  </item>
  <item>
    <shape
       android:shape="rectangle">
      <gradient
         android:startColor="@color/jx_btnStart"
         android:endColor="@color/jx_btnEnd"
         android:angle="90.0"/>
      <stroke
         android:width="1.0dip"
         android:color="@color/jx_start_bg"/>
      <corners
         android:topLeftRadius="100.0dip"
         android:topRightRadius="100.0dip"
         android:bottomLeftRadius="100.0dip"
         android:bottomRightRadius="100.0dip"/>
    </shape>
  </item>
</selector>